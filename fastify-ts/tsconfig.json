{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "lib/**/*", "generated/**/*"],
  "exclude": ["node_modules", "dist"]
}